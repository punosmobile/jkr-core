# Settings for the deploy scripts only. Template for deploy.dev.env,
# deploy.test.env and deploy.prod.env (not in git). The real values are in the
# team's password manager (Postman). In the pipeline the same keys are GitHub
# environment variables (vars).
SUBSCRIPTION=''   # subscription name or id
REGISTRY=''       # Container Registry name without .azurecr.io
RG=''             # environment resource group
APP=''            # backend Container App
